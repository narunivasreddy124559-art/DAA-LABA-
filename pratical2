// Interpolation Search Function int interpolationSearch(vector<int> arr, int key) 
{     int low = 0; 
    int high = arr.size() - 1; 
 
    while (low <= high && key >= arr[low] && key <= arr[high]) 
    {         if (low == high) 
        {             if (arr[low] == key)                 return low;             return -1; 
        } 
 
        int pos = low + ((double)(high - low) / 
                         (arr[high] - arr[low])) * (key - arr[low]); 
 
        if (arr[pos] == key)             return pos; 
 
        if (arr[pos] < key)             low = pos + 1;         else             high = pos - 1; 
    } 
 
    return -1; 
} 
 
