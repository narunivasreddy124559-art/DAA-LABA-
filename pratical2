#include <iostream> 
#include <vector> 
#include <cmath> 
#include <chrono> 
 
using namespace std; using namespace std::chrono; 
 
// Jump Search Function int jumpSearch(vector<int> arr, int key) 
{     int n = arr.size();     int step = sqrt(n);     int prev = 0; 
 
    while (arr[min(step, n) - 1] < key) 
    {         prev = step;         step += sqrt(n); 
 
        if (prev >= n)             return -1; 
    } 
 
    while (arr[prev] < key) 
    { 
        prev++; 
 
        if (prev == min(step, n))             return -1; 
    } 
 
    if (arr[prev] == key)         return prev; 
 
    return -1; 
} 
