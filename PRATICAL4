#include <iostream> 
using namespace std; 
 
// Recursive Function 
long long recursiveFactorial(int n) 
{ 
    if(n == 0 || n == 1) 
        return 1; 
    return n * recursiveFactorial(n - 1); 
} 
 
// Iterative Function 
long long iterativeFactorial(int n) 
{ 
    long long fact = 1; 
 
    for(int i = 1; i <= n; i++) 
        fact *= i; 
 
    return fact; 
} 
 
int main() 
{ 
    int n; 
 
    cout << "Enter a number: "; 
    cin >> n; 
 
    cout << "\nIterative Factorial = " 
         << iterativeFactorial(n); 
 
    cout << "\nRecursive Factorial = " 
         << recursiveFactorial(n); 
 
    return 0; 
